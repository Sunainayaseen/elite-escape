# Copy to backend/.env and fill in. Never commit the real .env file.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://eliteescape:eliteescape@db:5432/eliteescape

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# First admin account, created on first start (the seed never overwrites it later)
ADMIN_EMAIL=admin@eliteescape.com
# Required in production (12+ characters). Leave a strong value here for local use too.
ADMIN_PASSWORD=
ADMIN_NAME=Elite Escape Admin

# Optional: email yourself whenever a new enquiry or booking request arrives
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
