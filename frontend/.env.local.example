# Public base URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this site, used for canonical URLs, the sitemap and social previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Places API — powers real Google reviews in the Testimonials
# section. The section stays hidden until both are set and the place has reviews.
# Get these from https://console.cloud.google.com/ (enable "Places API",
# create a restricted API key) and the Place ID Finder at
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
