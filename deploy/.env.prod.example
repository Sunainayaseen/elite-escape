# Copy to .env.prod on the server (project root) and fill in every value.
# Never commit .env.prod.

# Public hostname of the API. Point its DNS A record at the VPS before starting.
API_DOMAIN=api.eliteescapetourism.com

POSTGRES_USER=eliteescape
# Use only letters and digits here: the password is embedded in the database connection URL,
# so characters such as @ : / # ? would break it. Make it long instead, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eliteescape

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME

# Your live frontend origin(s), comma-separated, no trailing slash
CORS_ORIGINS=https://eliteescapetourism.com,https://www.eliteescapetourism.com
# Main public site URL (used in password-reset emails)
FRONTEND_URL=https://eliteescapetourism.com

# First admin login. The API refuses to start in production unless ADMIN_PASSWORD is 12+ characters
# and JWT_SECRET_KEY is 32+ characters, so the CHANGE_ME placeholders must be replaced.
ADMIN_EMAIL=admin@eliteescapetourism.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Elite Escape Admin

# Optional email alerts for new enquiries and booking requests
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
